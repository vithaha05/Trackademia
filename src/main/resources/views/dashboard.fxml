<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.psgtech.studentportal.controllers.DashboardController"
      spacing="20" style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <children>
        <Label fx:id="userLabel" text="Welcome to Tracademia!"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="CGPA:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label fx:id="cgpaLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Current GPA:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label fx:id="gpaLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
        </HBox>

        <HBox spacing="20" alignment="CENTER_LEFT">
            <Label text="Semester:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
            <Label fx:id="semesterLabel" style="-fx-font-size: 20px;"/>
        </HBox>

        <VBox spacing="10">
            <Label text="Current Courses:" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="coursesLabel" style="-fx-font-size: 14px; -fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;"/>
        </VBox>

        <HBox spacing="20" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="logoutButton" text="Logout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-padding: 12 30; -fx-min-width: 100;"/>
        </HBox>
    </children>
</VBox>
