<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.effect.DropShadow?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.psgtech.studentportal.controllers.LoginController"
           styleClass="login-root">

    <!-- Background Gradient -->
    <VBox styleClass="gradient-background">
        <Region VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- Main Content -->
    <VBox alignment="CENTER" spacing="30" maxWidth="450" styleClass="login-container">
        <padding>
            <Insets top="60" right="50" bottom="60" left="50"/>
        </padding>

        <!-- Logo/Icon Section -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="🎓" styleClass="logo-emoji">
                <font>
                    <Font size="64"/>
                </font>
            </Label>
            <Label text="Tracademia" styleClass="app-title">
                <font>
                    <Font name="System Bold" size="42"/>
                </font>
            </Label>
            <Label text="PSG Tech Student Portal" styleClass="app-subtitle">
                <font>
                    <Font size="16"/>
                </font>
            </Label>
        </VBox>

        <!-- Login Form Card -->
        <VBox spacing="25" styleClass="login-card">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <!-- Roll Number Field -->
            <VBox spacing="8">
                <Label text="Roll Number" styleClass="field-label">
                    <font>
                        <Font size="13" name="System Bold"/>
                    </font>
                </Label>
                <TextField fx:id="rollNoField" promptText="Enter your roll number"
                           styleClass="modern-input" prefHeight="48">
                    <font>
                        <Font size="14"/>
                    </font>
                </TextField>
            </VBox>

            <!-- Password Field -->
            <VBox spacing="8">
                <Label text="Password" styleClass="field-label">
                    <font>
                        <Font size="13" name="System Bold"/>
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                              styleClass="modern-input" prefHeight="48">
                    <font>
                        <Font size="14"/>
                    </font>
                </PasswordField>
            </VBox>

            <!-- Status Label -->
            <Label fx:id="statusLabel" text="" wrapText="true" alignment="CENTER"
                   styleClass="status-label" maxWidth="350">
                <font>
                    <Font size="12"/>
                </font>
            </Label>

            <!-- Loading Indicator -->
            <ProgressIndicator fx:id="loadingIndicator" prefWidth="32" prefHeight="32" 
                              visible="false" styleClass="loading-indicator"/>

            <!-- Login Button -->
            <Button fx:id="loginButton" text="Sign In" prefWidth="350" prefHeight="50"
                    styleClass="primary-button">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Button>

            <!-- Info Text -->
            <Label text="Use your PSG Tech ecampus credentials to access your academic data" 
                   wrapText="true" alignment="CENTER" styleClass="info-text" maxWidth="350">
                <font>
                    <Font size="11"/>
                </font>
            </Label>
        </VBox>

        <!-- Footer -->
        <Label text="© 2024 Tracademia - Academic Performance Analytics" styleClass="footer-text">
            <font>
                <Font size="10"/>
            </font>
        </Label>
    </VBox>

</StackPane>
