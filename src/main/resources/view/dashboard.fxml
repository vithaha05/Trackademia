<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.campus.tracker.controller.DashboardController"
            style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI', Arial, sans-serif;">

    <!-- ==================== HEADER ==================== -->
    <top>
        <VBox style="-fx-background-color: #1e3a8a; -fx-padding: 16; -fx-spacing: 8;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="welcomeLabel" text="Welcome, Student" textFill="white">
                    <font>
                        <Font name="System Bold" size="26"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="rollNoLabel" text="Roll No: -" textFill="#e0e7ff">
                    <font>
                        <Font size="15"/>
                    </font>
                </Label>
                <Label fx:id="cgpaLabel" text="CGPA: 0.00" textFill="#fbbf24">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
                <Button text="Refresh" onAction="#handleRefresh"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;"
                        onMouseEntered="-fx-background-color: #2563eb;"
                        onMouseExited="-fx-background-color: #3b82f6;"/>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6;"
                        onMouseEntered="-fx-background-color: #dc2626;"
                        onMouseExited="-fx-background-color: #ef4444;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ==================== MAIN CONTENT ==================== -->
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-tab-min-height: 40; -fx-tab-max-height: 40;"
                 styleClass="tab-pane">

            <!-- =============== EXAM RESULTS TAB =============== -->
            <Tab text="Exam Results">
                <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                    <Label text="Semester Examination Results"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                    <!-- Summary Stats -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <Label text="Total Credits: " style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalCreditsLabel" text="0.0" style="-fx-text-fill: #3b82f6; -fx-font-weight: bold;"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                        <Label text="Earned Credits: " style="-fx-font-weight: bold;"/>
                        <Label fx:id="earnedCreditsLabel" text="0.0" style="-fx-text-fill: #10b981; -fx-font-weight: bold;"/>
                    </HBox>

                    <!-- Search Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="examSearchField" promptText="Search by Course Code or Title..."
                                   HBox.hgrow="ALWAYS" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                        <Button text="Clear" onAction="#clearExamSearch"
                                style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-padding: 8 16; -fx-background-radius: 8;"/>
                    </HBox>

                    <!-- Results Table -->
                    <TableView fx:id="examResultsTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colCourseCode" text="Course Code" prefWidth="130" />
                            <TableColumn fx:id="colCourseTitle" text="Course Title" prefWidth="380" />
                            <TableColumn fx:id="colCredit" text="Credits" prefWidth="90" />
                            <TableColumn fx:id="colGrade" text="Grade" prefWidth="90" />
                            <TableColumn fx:id="colGradePoint" text="Grade Point" prefWidth="110" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No exam results available." style="-fx-text-fill: #94a3b8;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>

            <!-- =============== CA MARKS TAB =============== -->
            <Tab text="CA Marks">
                <VBox spacing="20" style="-fx-padding: 24; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
                    <Label text="Continuous Assessment Marks (Provisional)"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                    <!-- Search Bar -->
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="caSearchField" promptText="Search by Course Code or Title..."
                                   HBox.hgrow="ALWAYS" style="-fx-background-radius: 8; -fx-padding: 10;"/>
                        <Button text="Clear" onAction="#clearCaSearch"
                                style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-padding: 8 16; -fx-background-radius: 8;"/>
                    </HBox>

                    <!-- CA Table -->
                    <TableView fx:id="caMarksTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="colCACode" text="Course Code" prefWidth="130"/>
                            <TableColumn fx:id="colCATitle" text="Course Title" prefWidth="350"/>
                            <TableColumn fx:id="colT1" text="T1" prefWidth="80"/>
                            <TableColumn fx:id="colT2" text="T2" prefWidth="80"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="80"/>
                            <TableColumn fx:id="colConvTotal" text="Conv. Total" prefWidth="110"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="No CA marks available." style="-fx-text-fill: #94a3b8;"/>
                        </placeholder>
                    </TableView>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="*" style="-fx-text-fill: #dc2626; -fx-font-weight: bold;"/>
                        <Label text="Mark entry is pending" style="-fx-font-size: 13; -fx-text-fill: #dc2626;"/>
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>
    </center>

</BorderPane>